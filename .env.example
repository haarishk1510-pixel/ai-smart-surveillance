# Copy to .env and fill in. Never commit .env.

# Dashboard
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set to 1 to run the dashboard on sample data with no MySQL
DEMO_MODE=0

# MySQL
DB_HOST=localhost
DB_NAME=surveillance_db
DASHBOARD_DB_USER=appuser
DASHBOARD_DB_PASSWORD=change-me
EDGE_DB_USER=root
EDGE_DB_PASSWORD=change-me

# AWS (credentials come from `aws configure` or the standard AWS_* variables)
S3_BUCKET=your-evidence-bucket
SNS_TOPIC_ARN=arn:aws:sns:your-region:your-account-id:your-topic

# Arduino
SERIAL_PORT=/dev/cu.usbmodem114401
